pkgname=ggorg-systemd-boot-manager-configs
pkgver=3
pkgrel=1
pkgdesc="Configuration files for sdboot-manage"
arch=('any')
license=('custom')
depends=('systemd-boot-manager')
source=('no-plymouth.conf' 'force-fsck.conf' 'hibernation.conf')
sha256sums=('SKIP' 'SKIP' 'SKIP')
install='sdboot-gen.install'

package() {
    for file in ${source[@]}; do
        install -Dm644 "$srcdir/$file" \
            "$pkgdir/usr/lib/sdboot-manage.conf.d/$file"
    done
}

