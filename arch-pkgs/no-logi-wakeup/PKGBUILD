pkgname="ggorg-no-logi-wakeup"
pkgver=1
pkgrel=1
pkgdesc="udev rule that disables wakeup for Logitech receivers"
arch=('any')
license=('custom')
depends=('systemd')
source=('49-logitech-receiver.rules')
sha256sums=('SKIP')

package() {
    install -Dm644 "$srcdir/49-logitech-receiver.rules" \
        "$pkgdir/usr/lib/udev/rules.d/49-logitech-receiver.rules"
}

