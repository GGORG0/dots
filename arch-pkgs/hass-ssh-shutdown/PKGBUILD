_pkgname=hass-ssh-shutdown
pkgname="ggorg-${_pkgname}"
pkgver=1
pkgrel=1
pkgdesc="SSH user for Home Assistant to suspend or power off the system"
arch=('any')
license=('custom')
depends=()
source=('authorized_keys' "49-${_pkgname}.rules" 'sysusers.conf' 'tmpfiles.conf')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
    install -Dm644 "$srcdir/sysusers.conf" \
        "$pkgdir/usr/lib/sysusers.d/${_pkgname}.conf"

    install -Dm644 "$srcdir/tmpfiles.conf" \
        "$pkgdir/usr/lib/tmpfiles.d/${_pkgname}.conf"

    install -dm700 "$pkgdir/var/lib/${_pkgname}"
    install -dm700 "$pkgdir/var/lib/${_pkgname}/.ssh"

    install -m600 "$srcdir/authorized_keys" \
        "$pkgdir/var/lib/${_pkgname}/.ssh/authorized_keys"

    install -Dm644 "$srcdir/49-${_pkgname}.rules" \
        "$pkgdir/usr/share/polkit-1/rules.d/49-${_pkgname}.rules"
}

